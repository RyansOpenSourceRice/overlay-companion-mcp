## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
# [Rr]elease/ - commented out to allow our release/ directory
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
# AppImage build outputs
build/


# AI GUI Test artifacts
tests/ai-gui/artifacts/

# Local virtualenv
/tests/ai-gui/.venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Server logs
*.log
server.log
/src/server.log

# OpenTofu generated artifacts
/deploy/opentofu/modules/*/generated/
/deploy/opentofu/envs/*/.terraform/
/deploy/opentofu/envs/*/.terraform.lock.hcl

# AI trajectory files
trajectory-*.json
trajectory.json

# Generated credentials and environment files
.credentials
.env
infra/.env

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# NOTE: package-lock.json is intentionally TRACKED. The management-server
# container build (`infra/Dockerfile.server`) does `COPY package-lock.json` +
# `npm ci`, which requires the lockfile in the repo for reproducible CI/registry
# builds. Do not gitignore it.

# Built SPA copied into the management server's static dir (see appium-tests.yml)
infra/server/public/

# TLS cert material + rendered terminator config (server identity; never commit
# private keys). Written by infra/server/src/tls-manager.ts.
infra/server/certs/

# Flatpak build artifacts
flatpak/clipboard-bridge/.flatpak-builder/
flatpak/clipboard-bridge/build/
flatpak/clipboard-bridge/repo/
flatpak/clipboard-bridge/*.flatpak

# Rust build artifacts
rust-mcp/target/
**/target/
**/*.rlib
**/*.rmeta
**/*.dSYM/
**/*.pdb
rust-mcp/.cargo/
# Optional: ignore Cargo.lock if this is not a published binary crate
# rust-mcp/Cargo.lock

# Rust tooling caches
/.rustup/
/.cargo/
**/.rustc_info.json

# IDE files
**/.idea/
**/.vscode/
**/*.iml
.venv/

# Rust clipboard bridge artifacts
rust-clipboard-bridge/target/
rust-clipboard-bridge/.cargo/

# Graphify knowledge-graph output (local analysis artifact, not source)
graphify-out/
.graphify_*.json
.ontology-hook-venv/
