<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>OverlayCompanion.Tests.Appium</RootNamespace>
    <AssemblyName>overlay-companion-appium-tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Appium is the preferred unified testing framework (preferences §9).
         C# Selenium/Appium is the implementation language. The web UI is
         browser-based, so tests drive Chrome via Appium's browser support. -->
    <PackageReference Include="Appium.WebDriver" Version="5.0.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.21.0" />
    <PackageReference Include="Selenium.Support" Version="4.21.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.4.3" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.4.3" />
  </ItemGroup>

</Project>
