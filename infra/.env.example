# Overlay Companion MCP - Compose configuration
# Copy to project root as .env and adjust values as needed

# Ports
CONTAINER_PORT=8080      # External port for caddy proxy -> web 8080
WEB_PORT=8082            # External port for web service -> internal 8080
MCP_PORT=3001            # External port for MCP server -> internal 3000
KASMVNC_PORT=6080        # External port for KasmVNC web (maps to 6901 in container)
KASMVNC_ADMIN_PORT=3000  # Admin interface for KasmVNC

# Optional registry credentials for Kasm image pulls
DOCKER_HUB_USERNAME=
DOCKER_HUB_PASSWORD=

# Timezone
TZ=Etc/UTC

# UID/GID to run services under (if applicable)
PUID=1000
PGID=1000

# Better Auth (the in-app auth engine, §7). Replaces the hand-rolled OIDC/Argon2id
# login. BETTER_AUTH_SECRET signs sessions (use `openssl rand -base64 48` in prod).
# ADMIN_EMAIL grants the admin role (RBAC) to one account on login.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080
# Optional WebAuthn passkeys (§7): rpID is the host users reach the server by
# (the relying-party ID, typically the hostname); origin must match BETTER_AUTH_URL.
BETTER_AUTH_PASSKEY_RP_ID=localhost
ADMIN_EMAIL=

# SurrealDB (the only database). Defaults match the compose service. Override
# the password in production. The TS and C# servers both connect with these.
SURREALDB_URL=http://surrealdb:8000
SURREALDB_NAMESPACE=overlay
SURREALDB_DATABASE=companion
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root
SURREALDB_PORT=8000

# Rust MCP HTTP port
RUST_MCP_PORT=3002

# Control MCP URL (when running separately)
CONTROL_MCP_URL=http://control-mcp:3003

# Wazuh / SIEM log shipping (§8). Admin-enabled in the Settings UI. These are
# bootstrap defaults only; the GUI is the source of truth. Wazuh itself is an
# external compose the admin runs separately — the app only ships logs to it.
WAZUH_ENABLED=false
WAZUH_ENDPOINT=
WAZUH_API_KEY=

# Public base URL the browser sees, for OIDC callback URLs. Set when behind a
# reverse proxy with a real hostname (e.g. https://overlay.example.com).
PUBLIC_BASE_URL=
