# Copy to .env and adjust. These are bootstrap defaults only; every secret here
# MUST be overridden before exposing this stack anywhere non-local.

# SigNoz ClickHouse password.
SIGNOZ_CLICKHOUSE_PASSWORD=change-me-strong-password

# Langfuse (LLM tracing). NEXTAUTH_URL must match the address you open.
LANGFUSE_URL=http://localhost:3333
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me-long-random
LANGFUSE_SALT=change-me-long-random
LANGFUSE_ENCRYPTION_KEY=change-me-32-byte-key

# OTLP Authorization header for Langfuse's OTLP endpoint:
#   echo -n "<public_key>:<secret_key>" | base64
# (Create a project in the Langfuse UI to get these.)
LANGFUSE_OTLP_AUTH=
