{
  "name": "overlay-companion-mcp-management",
  "version": "1.0.0",
  "description": "Management server for Overlay Companion MCP with Guacamole integration",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development node dist/server.js",
    "lint": "eslint 'src/**/*.ts' --ext .ts",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "keywords": [
    "mcp",
    "overlay",
    "guacamole",
    "websocket",
    "ai-assistant"
  ],
  "author": "Overlay Companion MCP",
  "license": "MIT",
  "dependencies": {
    "@better-auth/passkey": "^1.7.1",
    "@openfga/sdk": "^0.9.7",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "http-proxy-middleware": "^2.0.6",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.0.0",
    "surreal-better-auth": "^1.0.0",
    "surrealdb": "^1.3.2",
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=18.14.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cspell": "^6.13.0",
    "eslint": "^8.46.0",
    "eslint-plugin-security": "^1.7.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
